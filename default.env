# Gemini API Key
GEMINI_API_KEY=key-goes-here

# Zip Code
# Default = 90210
USER_ZIP=90210

# Timezone
# Default = America/New_York
TZ=America/New_York

# Monitor Number
# Default = 0
MONITOR_NUMBER=1

# ChatGPT Model
# Default = gpt-5
OPENAI_MODEL=gpt-5

# ChatGPT Text-to-Speech Model
# Default = tts-1
TTS_MODEL=tts-1