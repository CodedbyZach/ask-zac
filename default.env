# Gemini API Key
GEMINI_API_KEY=key-goes-here

# Zip Code
# Default = 12345
USER_ZIP=12345

# Timezone
# Default = America/New_York
TZ=America/New_York

# Monitor Number
# Default = 0
MONITOR_NUMBER=1

# Gemini Model
# Default = gemini-2.5-flash-lite
GEMINI_MODEL=gemini-2.5-flash-lite

# Alarm Sound
# Default = alarm-1.mp3 (do not use alarm 2 it is very annoying)
ALARM_SOUND=alarm-1.mp3